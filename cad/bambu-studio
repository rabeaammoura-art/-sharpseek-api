#!/usr/bin/env bash
# Run the Flathub Bambu Studio CLI without `flatpak run` (no D-Bus in containers):
# mount the app and its GNOME runtime with bubblewrap and keep host paths usable.
set -euo pipefail
APP=$(flatpak info --user --show-location com.bambulab.BambuStudio)/files
RUNTIME=$(flatpak info --user --show-location "$(flatpak info --user -m com.bambulab.BambuStudio | sed -n 's/^runtime=//p')")/files
exec bwrap \
  --ro-bind "$RUNTIME" /usr --ro-bind "$APP" /app \
  --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/bin /bin --symlink usr/sbin /sbin \
  --ro-bind /etc /etc --dev /dev --proc /proc \
  --bind /tmp /tmp --bind /home /home --bind "$HOME" "$HOME" --chdir "$PWD" \
  --setenv LC_ALL C.UTF-8 --setenv LD_LIBRARY_PATH /app/lib \
  /app/bin/bambu-studio "$@"
